# Modelo de variáveis de ambiente da Lottus. Copie para .env e preencha SÓ na sua máquina.
# O .env está no .gitignore: nunca versione valores reais.
#
# Os fronts em apps/ são estáticos e não leem variáveis de ambiente: o endereço do projeto
# Supabase e a chave PUBLICÁVEL ficam em apps/<plataforma>/js/config.js. A chave publicável
# (sb_publishable_...) é pública por definição e só funciona com RLS ligada em todas as tabelas.
#
# As variáveis abaixo servem a scripts locais e à CLI do Supabase. Segredos de produção
# (chave service_role, tokens da Trio, senhas de certificados) ficam no Vault do Supabase
# ou nos secrets das funções de borda, nunca aqui nem no front.

# URL do projeto ou do branch de testes do Supabase (ex.: https://<ref>.supabase.co)
SUPABASE_URL=
# Chave publicável do projeto ou do branch (pode ir ao front; não é segredo)
SUPABASE_PUBLISHABLE_KEY=
# Ref do projeto para a CLI (supabase link --project-ref). Use o ref de um BRANCH, não o de produção.
SUPABASE_PROJECT_REF=
# Token pessoal da CLI do Supabase (segredo: só na sua máquina)
SUPABASE_ACCESS_TOKEN=
